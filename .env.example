# LabPilot 环境变量模板
#
# 用法：复制为 .env 并填入自己的值。.env 已被 .gitignore 忽略（`.env` 与 `.env.*`），
# 不会进版本库；密钥也可以只放在系统环境变量里，不建这个文件。
#
# 复制命令（Windows PowerShell）：
#     Copy-Item .env.example .env
#
# 注意：密钥只放在本地。项目里的任何文件、数据库、任务记录都不写密钥。

# ── 思考模型（对话、参数抽取、候选评估、报告撰写都需要）─────────────────
# 未配置时对话与分析不可用，页面顶部显示「配置有误」；密钥无效或网络不通才显示「未连接」。
DEEPSEEK_API_KEY=
DEEPSEEK_ENDPOINT=
DEEPSEEK_MODEL=

# ── 可选：独立联网检索通道 ──────────────────────────────────────────
# 不配置时使用内置的公开检索通道。某个通道本次失败或没有结果时，
# 结果里会点名是哪个通道，其他通道照常使用。
TAVILY_API_KEY=

# ── 可选：读取需要执行脚本才能出正文的页面 ───────────────────────────
LAB_BROWSER_READING=

# ── 可选：对启用 WAF 的站点启用 TLS 模拟传输 ────────────────────────
# 需要额外安装可选依赖：pip install -e ".[impersonate]"
LAB_IMPERSONATE_HTTP=

# ── 可选：模型调用账本与限流 ────────────────────────────────────────
LAB_USAGE_DATABASE=
LAB_MODEL_CALLS_PER_HOUR=

# ── 可选：允许访问 API 的前端来源（逗号分隔）────────────────────────
LAB_CORS_ORIGINS=

# ── 可选：扫描件视觉解析的超时与上限 ────────────────────────────────
# LAB_VISION_TIMEOUT 允许 0～180 秒；LAB_VISION_JSON_RETRIES 允许 0～3。
# 取值超出范围时，服务会直接报错并点名这个配置项，不会退回默认值继续跑。
LAB_VISION_TIMEOUT=45
LAB_VISION_MAX_PAGES=20
LAB_VISION_JSON_RETRIES=1

# ── 可选：模型调用的金额闸门（默认关闭）─────────────────────────────
# 打开金额闸门必须同时给出下面两个值；只设其中一个会明确报错，不会编一个默认额度。
# LAB_COST_LEDGER=
# LAB_COST_INITIAL_CNY=
# LAB_COST_LIMIT_CNY=
