__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
node_modules/
.vite/
frontend/dist/
data/*
storage/*
!data/.gitkeep
!storage/.gitkeep
.env
.env.*
!.env.example
*.db
# SQLite runtime files: ``*.sqlite`` alone misses ``.sqlite3`` databases and the
# ``-wal`` / ``-shm`` sidecars that appear next to a database while it is open.
*.sqlite*
*.log
.playwright-cli/
.workbuddy/
tmp/
output/
.tmp-tests/
.pytest_tmp*/
# pytest temp roots created by a plain ``pytest`` run cannot always be removed
# afterwards: ``mkdir(mode=0o700)`` materialises a DACL this token does not own.
.tmp-pytest*/

# Local working copies left behind by editors and agents; never committed.
*.bak
*_backup.py

.venv/
.impeccable/review/chrome-*/
.impeccable/review/*.png

# User-provided source documents (never commit)
/*.pdf

# The local direct-purchase price database ships with the demo so a fresh clone
# reads real transaction rows without re-scraping. Read-only, 17 MB, built from
# public procurement publicity pages; override the path with LAB_XLYG_DB.
!data/xlyg_prices.sqlite3
